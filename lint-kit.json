{
  "profile": "docs-only",
  "languages": ["mjs"],
  "ignore": ["node_modules/**", "dist/**", ".git/**", "coverage/**"],
  "proseGlobs": [
    "README.md",
    "**/README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "docs/**/*.md"
  ],
  "boundaryFiles": [],
  "baseline": ".lint-kit-baseline.json",
  "rules": {
    "R1": "error",
    "R2": "error",
    "R4": "error",
    "R8": "error",
    "R16": "error",
    "R22": "error",
    "R23": "error"
  },
  "prose": {
    "allow": []
  }
}
